# ───────────────────────────────────────────────
# Game Changer — Environment Variables
# העתק קובץ זה ל-.env.local ומלא את הערכים
# (הסקריפט setup.mjs עושה את זה אוטומטית)
# ───────────────────────────────────────────────

# Supabase
# קח את הערכים מ: https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Vercel AI Gateway
# 5$ קרדיט חינם כל חודש — https://vercel.com/ai-gateway
AI_GATEWAY_API_KEY=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
